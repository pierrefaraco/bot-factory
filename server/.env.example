# Template for server/.env — copy to .env and fill in real values.
# .env is gitignored; this file is committed and must never contain real secrets.

FLASK_APP=ai_server.main
FLASK_PORT=444
FLASK_ENV=development
FLASK_DEBUG=True
API_URL_PREFIX=/api

# Logger settings
LOGGER_LVL=DEBUG
VERBOSE=False
DEACTIVATE_SERVER_LOG=False
OPERATIONAL_LOG_FILE=ai-server-{}.log
OPERATIONAL_LOG_FILE_MAXSIZE=100

CHROMA_CONTAINER=true
CHROMA_HOST=localhost
CHROMA_PORT=8000
PERSIST=true
PERSIST_DIRECTORY=chroma_db_2
LD_LIBRARY_PATH=/usr/local/lib
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/botcraft?charset=utf8mb4
CERT_PATH=
PRIVATE_KEY_PATH=

SUPER_ADMIN_LOGIN=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

MISTRAL_API_KEY=a...
MISTRAL_MODEL="mistral-medium"