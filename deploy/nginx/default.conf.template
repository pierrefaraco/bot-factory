# Public TLS-terminating reverse proxy for production (see deploy/README.md).
# Rendered from this template via the nginx:alpine image's built-in
# envsubst-on-templates entrypoint hook, which only substitutes names that
# are actual container env vars -- nginx's own request variables below
# ($host, $scheme, $remote_addr, ...) are untouched, same mechanism already
# used by client/nginx.conf.template for ${API_HOST}.

server {
  listen 80;
  server_name ${DOMAIN};

  # Let's Encrypt HTTP-01 challenge (see deploy/certbot/init-letsencrypt.sh
  # and the "certbot" service in docker-compose.prod.yml, which share this
  # webroot volume with this container).
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  # Everything else: force HTTPS.
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_session_timeout 1d;
  ssl_session_cache   shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

  # Still needed here for certbot's renewal HTTP-01 challenge, which hits
  # port 80 and gets redirected to https by the server block above.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    proxy_pass http://web:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    # web's own nginx already disables buffering on /api/ for the SSE chat
    # endpoints (see client/nginx.conf.template) -- do the same here, or
    # this outer hop re-introduces the same delivery-in-one-chunk bug.
    proxy_buffering off;
  }
}
