worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for"';

  access_log /var/log/nginx/access.log main;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  types_hash_max_size 2048;
  client_max_body_size 20M;

  # ---- Rate limiting, per client IP --------------------------------------
  # Behind the production reverse proxy (docker-compose.prod.yml), the peer
  # address is that proxy: take the client's IP from X-Forwarded-For, trusting
  # only private (Docker network) hops. With recursive on, nginx keeps the
  # right-most untrusted address, so entries a client forges itself are ignored.
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # An empty key is not counted: each zone only applies to the requests its
  # map selects. Credential-taking logins (brute force), and the chat
  # endpoints, each of which costs Mistral tokens.
  map "$request_method:$uri" $auth_limit_key {
    ~^POST:/api/auth/(login|google|demo|magic-link)$  $binary_remote_addr;
    default                                           "";
  }
  map "$uri" $chat_limit_key {
    ~^/api/rag/(chat|streamchat|trigfirstmessage)$    $binary_remote_addr;
    default                                           "";
  }
  limit_req_zone $auth_limit_key zone=auth:10m rate=10r/m;
  limit_req_zone $chat_limit_key zone=chat:10m rate=30r/m;
  limit_req_status 429;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_types text/plain text/css text/xml text/javascript
             application/json application/javascript application/xml+rss
             application/rss+xml font/truetype font/opentype
             application/vnd.ms-fontobject image/svg+xml;

  server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Enable gzip
    gzip on;

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
      expires 30d;
      add_header Cache-Control "public, immutable";
    }

    # Proxy API requests to backend
    # API_HOST defaults to "api" (docker compose service). Override to
    # "host.docker.internal" to reach a backend run locally via z-run.sh.
    # Same {"error": "..."} shape as the API's own errors.
    error_page 429 @too_many_requests;
    location @too_many_requests {
      default_type application/json;
      return 429 '{"error": "Too many requests, please try again in a minute."}';
    }

    location /api/ {
      limit_req zone=auth burst=10 nodelay;
      limit_req zone=chat burst=10 nodelay;
      proxy_pass http://${API_HOST}:8000;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_cache_bypass $http_upgrade;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      # proxy_buffering defaults to "on": nginx accumulates the whole
      # upstream response in its own buffers and only flushes it to the
      # browser once full/closed. For the SSE chat endpoints
      # (/api/rag/streamchat, /api/rag/trigfirstmessage) this silently
      # turns real token-by-token streaming from Flask into one single
      # delivery at the end -- the backend and frontend were both already
      # correct, this proxy setting was erasing the effect between them.
      # Harmless to disable for the rest of /api/ too (plain JSON
      # responses aren't large enough for buffering to matter).
      proxy_buffering off;
      proxy_cache off;
      chunked_transfer_encoding on;
    }

    # Angular routing - serve index.html for all routes
    location / {
      try_files $uri $uri/ /index.html;
      # Prevent caching of index.html
      add_header Cache-Control "no-cache, no-store, must-revalidate";
      add_header Pragma "no-cache";
      add_header Expires "0";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
  }
}
