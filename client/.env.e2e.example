# Template for the Playwright E2E env vars — copy to .env.e2e and fill in
# real values, then export them before running the suite:
#   set -a && source .env.e2e && set +a && npm run e2e
# .env.e2e is gitignored; this file is committed and must never contain real
# secrets.

# There is no API to create a fresh Admin account (the role-change route
# itself requires an existing Admin caller), so admin.spec.ts has to
# authenticate as the pre-seeded super-admin. Use the exact same values as
# SUPER_ADMIN_LOGIN / SUPER_ADMIN_PASSWORD in server/.env.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me

# Optional: only needed if the app isn't served at the default
# `ng serve --port 443` address (see client/package.json's "start" script).
# E2E_BASE_URL=http://localhost:443
