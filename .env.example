# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=botcraft
MYSQL_USER=botcraft_user
MYSQL_PASSWORD=123456789

# MySQL host used by the "api" container to build its DATABASE_URL:
# when api runs in docker compose and MySQL is the "db" service on the same network
MYSQL_HOST=db
# when api container needs to reach a MySQL instance that is NOT on this
# docker compose network (e.g. running on the host, or in another Docker network)
# MYSQL_HOST=host.docker.internal

# Flask Configuration
FLASK_APP=ai_server.main
FLASK_ENV=development
FLASK_DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Google OAuth (Sign in with Google). Same value must reach both the "api"
# and "web" containers (see docker-compose.yml) -- the frontend uses it to
# initialize Google Identity Services, the backend uses it to verify the
# returned ID token. Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") and add this app's origin(s) to
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=913568537440-clfeb4jvitdh7111s1j8cv6u8gb6t3dv.apps.googleusercontent.com

# Vibe API-KEY
MISTRAL_API_KEY="a...."

# ChromaDB Vector Store
CHROMA_CONTAINER=true
CHROMA_HOST=chromadb
CHROMA_PORT=8000
PERSIST=true
PERSIST_DIRECTORY=chroma_db_2

# Logging
LOGGER_LVL=INFO
VERBOSE=False
DEACTIVATE_SERVER_LOG=False
OPERATIONAL_LOG_FILE=ai-server-{}.log
OPERATIONAL_LOG_FILE_MAXSIZE=100

# Admin User Configuration
SUPER_ADMIN_LOGIN=jhon.doe@yahoocom
SUPER_ADMIN_PASSWORD=123

# Development/Deployment
ENVIRONMENT=development
DEBUG=true

# Host port the "web" (frontend) container is published on. Change this if
# 8080 is already used on your machine (e.g. WSL/Windows port conflicts).
WEB_PORT=8080


# when api run in docker
API_HOST=api
# when api run on os
# API_HOST=host.docker.internal