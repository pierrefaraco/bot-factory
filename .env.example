# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=botcraft
MYSQL_USER=botcraft_user
MYSQL_PASSWORD=123456789

# MySQL host used by the "api" container to build its DATABASE_URL:
# when api runs in docker compose and MySQL is the "db" service on the same network
MYSQL_HOST=db
# when api container needs to reach a MySQL instance that is NOT on this
# docker compose network (e.g. running on the host, or in another Docker network)
# MYSQL_HOST=host.docker.internal

# Flask Configuration
FLASK_APP=ai_server.main
FLASK_ENV=development
FLASK_DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Google OAuth (Sign in with Google). Same value must reach both the "api"
# and "web" containers (see docker-compose.yml) -- the frontend uses it to
# initialize Google Identity Services, the backend uses it to verify the
# returned ID token. Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") and add this app's origin(s) to
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=913568537440-clfeb4jvitdh7111s1j8cv6u8gb6t3dv.apps.googleusercontent.com

# Vibe API-KEY
MISTRAL_API_KEY="a...."

# Token limit: max tokens an account (itself + its guests) may consume over a
# rolling 24h window. Beyond it, chat requests get HTTP 429. 0 = unlimited.
# Admins are never limited.
TOKEN_LIMIT_PER_USER_24H=0

# ===== Vector store (ChromaDB) =====
# CHROMA_CONTAINER=true: the api talks to a Chroma server at CHROMA_HOST:CHROMA_PORT
# ("chromadb" = the docker compose service; "localhost" if the api runs outside compose).
# CHROMA_CONTAINER=false: Chroma runs inside the api process, persisted under
# PERSIST_DIRECTORY if PERSIST=true, in memory only (lost on restart) otherwise.
CHROMA_CONTAINER=true
CHROMA_HOST=chromadb
CHROMA_PORT=8000
PERSIST=true
PERSIST_DIRECTORY=chroma_db_2

# Embedding model (FastEmbed) used at ingestion AND at query time.
# intfloat/multilingual-e5-large: multilingual (~100 languages, French included), best
# retrieval quality among FastEmbed's models, 512-token input, 2.2 GB (downloaded once,
# see FASTEMBED_CACHE_PATH; needs ~3 GB of RAM). The "query: "/"passage: " prefixes it
# expects are added automatically (vector_store_facade.py).
# Lighter alternative (0.22 GB, less accurate): sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# with RAG_CHUNK_SIZE=500, RAG_CHUNK_OVERLAP=75, RAG_RETRIEVER_K=16 (it was trained on short texts).
# ⚠️ After changing it, re-ingest every bot (POST /api/rag/reindex/{bot_id}):
# vectors from two different models are not comparable, and retrieval silently degrades.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Chunking at ingestion, in characters (applies to what is ingested next).
# 1024 chars ≈ 270 tokens of French: under the model's 512-token limit, one paragraph.
# The overlap (≈15%) keeps a sentence cut at a chunk boundary whole in one of the chunks.
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=150

# Chunks retrieved per question and put into the prompt (12 x ~270 tokens ≈ 3k tokens).
# Higher = better recall but a longer (costlier) prompt; below ~8, relevant chunks get missed.
RAG_RETRIEVER_K=12

# Logging
LOGGER_LVL=INFO
VERBOSE=False
DEACTIVATE_SERVER_LOG=False
OPERATIONAL_LOG_FILE=ai-server-{}.log
OPERATIONAL_LOG_FILE_MAXSIZE=100

# Admin User Configuration
SUPER_ADMIN_LOGIN=jhon.doe@yahoocom
SUPER_ADMIN_PASSWORD=123

# Development/Deployment
ENVIRONMENT=development
DEBUG=true

# Host port the "web" (frontend) container is published on. Change this if
# 8080 is already used on your machine (e.g. WSL/Windows port conflicts).
WEB_PORT=8080


# when api run in docker
API_HOST=api
# when api run on os
# API_HOST=host.docker.internal

# HTTPS in production (docker-compose.prod.yml, see deploy/README.md).
# DOMAIN must already resolve (DNS A/AAAA record) to this server's public IP
# before running deploy/certbot/init-letsencrypt.sh. LETSENCRYPT_EMAIL is
# only used by Let's Encrypt for expiry/abuse notices.
# DOMAIN=bots.example.com
# LETSENCRYPT_EMAIL=you@example.com
# Uncomment while testing to hit Let's Encrypt's staging CA (untrusted certs,
# but no risk of tripping the production rate limits with repeated runs).
# LETSENCRYPT_STAGING=1


# Max tokens per account (itself + its guests) over a rolling 24h window;
# beyond it chat requests get HTTP 429. 0 = unlimited. Admins are exempt.
TOKEN_LIMIT_PER_USER_24H=1000